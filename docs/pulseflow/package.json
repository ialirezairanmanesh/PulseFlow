{
  "name": "pulseflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c teal,cyan \"npm run bridge\" \"next dev -p 3846 -H 0.0.0.0 --webpack\"",
    "bridge": "cd ../../pulseflow_bridge && dart run bin/pulseflow_bridge.dart",
    "bridge:node": "tsx server/bridge.ts",
    "build": "next build",
    "start": "concurrently -k -n bridge,web -c teal,cyan \"npm run bridge\" \"next start -p 3846 -H 0.0.0.0\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.544.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-flame-graph": "^1.4.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
